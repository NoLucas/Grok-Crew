# Public host only. Do not commit a real .env.

# Show the existing homepage at /
GROK_CREW_PUBLIC_SITE=1

# Optional extra browser origin allowed to POST /api/get
# GROK_CREW_PUBLIC_ORIGIN=https://example.com

# Windows file after a valid email. Default is the GitHub Release exe.
# GROK_CREW_DOWNLOAD_URL=https://github.com/NoLucas/Grok-crew-test/releases/latest/download/GrokCrew-Windows.exe

# Optional AWS free-tier bucket for emails. Empty = local data/leads.jsonl
# GROK_CREW_LEADS_BUCKET=grok-crew-leads
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
