# Public homepage is /home. Optional live origin that may call POST /api/get:
# GROK_CREW_PUBLIC_ORIGIN=https://grok-crew-local.jinegcc.chatgpt.site

# Windows file URL if you serve the exe yourself. Default is the GitHub Release.
# GROK_CREW_DOWNLOAD_URL=https://github.com/NoLucas/Grok-Crew/releases/latest/download/GrokCrew-Windows.exe

# Optional local email list. Empty path uses data/leads.jsonl.
# GROK_CREW_LEADS_PATH=
# GROK_CREW_LEADS_BUCKET=
