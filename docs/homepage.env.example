# Public homepage is /home.
# Optional extra origin that may call POST /api/get (your live page).
# Do not commit a personal host.
# GROK_CREW_PUBLIC_ORIGIN=https://example.com

# Windows file URL if you serve the exe yourself. Must be https on GitHub.
# GROK_CREW_DOWNLOAD_URL=https://github.com/NoLucas/Grok-Crew/releases/latest/download/GrokCrew-Windows.exe

# Optional local email list. Empty path uses data/leads.jsonl.
# GROK_CREW_LEADS_PATH=
# GROK_CREW_LEADS_BUCKET=
