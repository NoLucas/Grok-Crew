# Keep these only in local_studio/.env. Do not commit real credentials.
LOCAL_STUDIO_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# Optional: only used by local_studio/handoff_watcher.py (cloud bot handoff).
# Not a secret — just where your dedicated handoff repo/branch lives.
# These must match the "channel" block in local_studio/handoff-guide.json —
# if you edit one, edit the other. Left blank/default, the watcher polls a
# "handoff-inbox" branch on THIS repo's own origin, which is safe (that
# branch normally doesn't exist) but won't receive anything until you either
# fill these in or create that branch yourself. Example matching the shipped
# handoff-guide.json:
#   HANDOFF_REPO_REMOTE=https://github.com/NoLucas/handoff-inbox.git
#   HANDOFF_BRANCH=main
HANDOFF_REPO_REMOTE=
HANDOFF_BRANCH=handoff-inbox

# Optional caps for local_studio/handoff_watcher.py (see handoff-guide.json's
# "limits" block for the values advertised to a remote bot).
HANDOFF_MAX_MEDIA_BYTES=
HANDOFF_MAX_BUNDLE_BYTES=
HANDOFF_MAX_PACKAGES_PER_CYCLE=
